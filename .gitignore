# =====================================================
# RecoverAI / RevivePay AI — .gitignore
# Monorepo: Vite (React) + Node/Express + Supabase
# =====================================================

# ----- Dependencies -----
node_modules/
**/node_modules/

# ----- Build outputs -----
dist/
build/
**/dist/
**/build/
.next/
out/

# ----- Environment secrets — NEVER commit these -----
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
**/.env
**/.env.local
**/.env.*.local

# ----- Logs -----
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log
logs/

# ----- OS & Editor -----
.DS_Store
Thumbs.db
.vscode/settings.json
.idea/

# ----- TypeScript -----
*.tsbuildinfo
**/tsconfig.tsbuildinfo

# ----- Vite cache -----
.vite/
**/.vite/

# ----- Supabase local -----
supabase/.branches/
supabase/.temp/

# ----- Testing -----
coverage/
.nyc_output/

# ----- Misc -----
*.pem
*.key
.cache/
